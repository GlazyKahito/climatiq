# ─────────────────────────────────────────────────────────────────────────────
# CLIMATIQ environment variables
# Copy to .env.local for local development (npm run dev creates one automatically).
# Never commit real secrets. All variables are read on the server only.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────────────────────
# Local dev: leave unset in .env.local and `npm run dev` starts an embedded PostgreSQL 18
# on port 54330 (postgres://postgres:postgres@localhost:54330/climatiq).
# Production: pooled connection string of your managed Postgres (e.g. Neon via the Vercel Marketplace).
DATABASE_URL=
# Optional: direct (non-pooled) URL used only for migrations; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Optional: set to true when the provider requires TLS without a CA bundle (Neon's URL already has sslmode=require).
DATABASE_SSL=
# Optional: pg pool size per server instance (default 5; keep small on serverless).
DATABASE_POOL_MAX=

# ── Security (required) ──────────────────────────────────────────────────────
# ≥ 32 random characters used to sign session cookies. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>` to /api/v1/cron/refresh (optional; disables cron if unset).
CRON_SECRET=

# ── Demo mode ────────────────────────────────────────────────────────────────
# true → one-click fictional demo accounts, role switcher, auto-seeding of an empty database, demo reset.
# Leave false for any real deployment.
DEMO_MODE=true
APP_URL=http://localhost:3100

# ── AI advisory provider (optional) ──────────────────────────────────────────
# template = deterministic advisories (no external AI, always available)
# gemini   = Google Gemini API (free tier; prompts may be used to improve Google products — only public weather data is sent)
# anthropic = Claude API (paid)
AI_PROVIDER=template
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ── Weather data (optional overrides) ────────────────────────────────────────
# Open-Meteo needs no key for non-commercial use. Set an API key only if you have a paid plan.
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_API_KEY=
